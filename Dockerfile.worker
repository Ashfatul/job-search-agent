FROM node:22-bookworm-slim

WORKDIR /app
COPY package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/worker/package.json apps/worker/

RUN npm install --workspace=packages/shared --workspace=apps/worker --include-workspace-root=false

COPY packages/shared packages/shared
COPY apps/worker apps/worker

RUN npm --workspace=packages/shared run build && npm --workspace=apps/worker run build

# Install Playwright Chromium only if ENABLE_PLAYWRIGHT=true is desired at image build time
RUN npx --workspace=apps/worker playwright install chromium --with-deps || true

ENV NODE_ENV=production
EXPOSE 4001
CMD ["npm", "--workspace=apps/worker", "run", "start"]
