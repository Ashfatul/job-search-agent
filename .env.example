# =============================================================================
# Job Search Bot — 100% Free Tier Environment Configuration
# =============================================================================

# --- 1. Supabase (Free Tier: 500MB Postgres + Auth + pg_trgm + pgvector) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side only (used by VPS worker & privileged server routes - NEVER expose to browser/extension)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- 2. Free LLM Providers (Configure at least ONE; all 3 give automatic fallback) ---
# Google AI Studio (Free tier, no credit card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq (Free tier, ultra-fast, no credit card): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (Free :free models, no credit card): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free

# --- 3. Auth & Worker Security ---
# Set to "false" after creating your account to lock down signups on your private deployment
NEXT_PUBLIC_ALLOW_SIGNUP=true
# Optional comma-separated allowlist of authorized user emails
ALLOWED_USER_EMAILS=
# Shared secret so Web Dashboard can trigger/authenticate manual worker runs
WORKER_SECRET=change_me_to_a_long_random_hex_string
WEB_APP_URL=http://localhost:3000
WORKER_PORT=4001
WORKER_URL=http://127.0.0.1:4001

# --- 4. Email Sending (100% Free) ---
# Option A (Recommended): Gmail App Password SMTP (sends from your real Gmail inbox)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SENDER_NAME=Your Full Name

# Option B (Optional): Brevo Free SMTP/API for summary digest emails (300/day, no domain required)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- 5. Telegram Bot (100% Free via @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 6. Optional Free Job Board API Keys ---
# Adzuna Free Tier: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# --- 7. Worker Safety & Schedule ---
# Set DRY_RUN=true during initial testing to draft & preview without sending real emails
DRY_RUN=true
# Default cron: every 6 hours (0 */6 * * *)
DEFAULT_CRON_SCHEDULE=0 */6 * * *
# Enable Playwright fallback for JS-rendered public career pages (keep false on <512MB RAM VPS)
ENABLE_PLAYWRIGHT=true
